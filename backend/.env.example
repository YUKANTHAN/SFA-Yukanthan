# ---------------------------------------------------------------------------
# EduPulse Analytics - backend configuration
#
# Copy to `.env` and fill in. NEVER commit the filled-in copy.
# These credentials live on the server only; the browser bundle never sees them.
# ---------------------------------------------------------------------------

# From Supabase -> Project Settings -> API
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Effectively REQUIRED. Reads AND writes use this key: reads to bypass RLS
# (`feedback` and `feedback_themes` are select-only for authenticated admins),
# writes because there is no public INSERT policy - the API is the only writer.
# Leave it blank and `db.admin_client()` falls back to the anon key with a
# warning on every call; RLS then rejects the write with a 42501 and the submit
# form returns 502. There is no `seed_admin.py`; use:
#   python scripts/bootstrap_admin.py <email> <password>
# which creates the Auth user and promotes its profile in one step.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When true, GET /api/feedback, /api/feedback/themes and /api/feedback/{id}
# require a valid admin bearer token. Set false only for local UI work - it
# exposes the raw corpus publicly.
REQUIRE_AUTH_ON_READS=true

# Crude per-IP submission throttle for the public write endpoint.
SUBMISSIONS_PER_HOUR=30
