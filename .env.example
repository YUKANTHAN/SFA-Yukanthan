# Frontend configuration.
#
# The browser talks ONLY to the Python API. There is no database URL and no
# anon key here any more - both live in backend/.env.
#
# Copy this file to `.env.local` only if you need to override a default.

# Where the app sends API requests.
# Leave as '/api' and let vite.config.js proxy it to the backend, which
# avoids CORS entirely. Set an absolute URL (e.g. https://api.example.edu/api)
# only when the API is deployed on another origin.
VITE_API_BASE_URL=/api

# Dev-server proxy target. Backend default is http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
